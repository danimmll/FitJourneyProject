<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="24dp"
        android:weightSum="2">

        <FrameLayout
            android:id="@+id/frameHero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/ivDetailImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/exercise_image"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_launcher_background" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_hero" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:lineSpacingExtra="2dp"
                android:textAllCaps="true"
                android:textColor="@color/text"
                android:textSize="28sp"
                tools:text="Barbell Bench Press" />

            <LinearLayout
                android:id="@+id/linearLayoutTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailMuscle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded"
                    android:backgroundTint="@color/mainrosa"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textAllCaps="true"
                    android:textColor="@color/text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Pecho" />

                <TextView
                    android:id="@+id/tvDetailDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/rounded"
                    android:backgroundTint="@color/mainazul"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textAllCaps="true"
                    android:textColor="@color/text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Avanzado" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnYoutube"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#E52D27"
                android:letterSpacing="0.05"
                android:text="VER VÍDEO EN YOUTUBE"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_media_play"
                app:iconTint="@color/white" />

            <View
                android:id="@+id/dividerInstructions"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:background="@color/mainrosa" />

            <TextView
                android:id="@+id/tvLabelInstructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="@string/instructions"
                android:textAllCaps="true"
                android:textColor="@color/mainrosa"
                android:textSize="16sp"
                app:drawableStartCompat="@android:drawable/ic_menu_sort_by_size"
                app:drawableTint="@color/mainrosa" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/viewholder_instruction" />

            <LinearLayout
                android:id="@+id/adminPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="@color/mainazul"
                    android:text="@string/edit"
                    android:textAllCaps="true"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="textStart"
                    app:iconTint="@color/text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#C62828"
                    android:text="@string/delete"
                    android:textAllCaps="true"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/text" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>