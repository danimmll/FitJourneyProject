<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_second"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="es.iesagora.fitjourney.ui.second.home.HomeFragment"
        android:label=""
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/exercisesFragment"
        android:name="es.iesagora.fitjourney.ui.second.fitnesscenter.exercises.ExercisesFragment"
        android:label=""
        tools:layout="@layout/fragment_exercises">

        <action
            android:id="@+id/action_exercises_to_detail"
            app:destination="@id/exerciseDetailFragment" />

        <action
            android:id="@+id/action_exercises_to_form"
            app:destination="@id/formExerciseFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="es.iesagora.fitjourney.ui.second.profile.ProfileFragment"
        android:label=""
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/fitnessCenterFragment"
        android:name="es.iesagora.fitjourney.ui.second.fitnesscenter.FitnessCenterFragment"
        android:label=""
        tools:layout="@layout/fragment_fitness_center" />

    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="es.iesagora.fitjourney.ui.second.fitnesscenter.exercises.ExerciseDetailFragment"
        android:label=""
        tools:layout="@layout/fragment_exercise_detail">

        <action
            android:id="@+id/action_detail_to_form"
            app:destination="@id/formExerciseFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="es.iesagora.fitjourney.ui.second.settings.SettingsFragment"
        android:label=""
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/routinesFragment"
        android:name="es.iesagora.fitjourney.ui.second.fitnesscenter.routines.RoutinesFragment"
        android:label=""
        tools:layout="@layout/fragment_routines" >
        <action
            android:id="@+id/action_routinesFragment_to_formRoutineFragment"
            app:destination="@id/formRoutineFragment" />
        <action
            android:id="@+id/action_routinesFragment_to_routineDetailFragment"
            app:destination="@id/routineDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/formExerciseFragment"
        android:name="es.iesagora.fitjourney.ui.second.fitnesscenter.exercises.FormExerciseFragment"
        android:label=""
        tools:layout="@layout/fragment_form_exercise">

        <argument
            android:name="exercise_data"
            app:argType="es.iesagora.fitjourney.data.model.Exercise"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="es.iesagora.fitjourney.ui.second.profile.EditProfileFragment"
        android:label=""
        tools:layout="@layout/fragment_edit_profile">

        <argument
            android:name="user_data"
            app:argType="es.iesagora.fitjourney.data.model.User"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/formWorkoutFragment"
        android:name="es.iesagora.fitjourney.ui.second.fitnesscenter.workouts.FormWorkoutFragment"
        android:label=""
        tools:layout="@layout/fragment_form_workout" />

    <fragment
        android:id="@+id/formRoutineFragment"
        android:name="es.iesagora.fitjourney.ui.second.fitnesscenter.routines.FormRoutineFragment"
        android:label=""
        tools:layout="@layout/fragment_form_routine" />

    <fragment
        android:id="@+id/adminUsersFragment"
        android:name="es.iesagora.fitjourney.ui.second.adminusers.AdminUsersFragment"
        android:label=""
        tools:layout="@layout/fragment_admin_users" />

    <fragment
        android:id="@+id/routineDetailFragment"
        android:name="es.iesagora.fitjourney.ui.second.fitnesscenter.routines.RoutineDetailFragment"
        android:label=""
        tools:layout="@layout/fragment_routine_detail">

        <action
            android:id="@+id/action_routineDetail_to_exerciseDetail"
            app:destination="@id/exerciseDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/workoutHistoryFragment"
        android:name="es.iesagora.fitjourney.ui.second.workouthistory.WorkoutHistoryFragment"
        android:label=""
        tools:layout="@layout/fragment_workout_history" />

    <fragment
        android:id="@+id/workoutHistoryDetailFragment"
        android:name="es.iesagora.fitjourney.ui.second.workouthistory.WorkoutHistoryDetailFragment"
        android:label=""
        tools:layout="@layout/fragment_workout_history_detail" />

</navigation>