<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/accessFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="es.iesagora.fitjourney.ui.main.origin.login.LoginFragment"
        android:label=""
        tools:layout="@layout/fragment_login" >
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="es.iesagora.fitjourney.ui.main.origin.register.RegisterFragment"
        android:label=""
        tools:layout="@layout/fragment_register" >
    </fragment>
    <fragment
        android:id="@+id/accessFragment"
        android:name="es.iesagora.fitjourney.ui.main.origin.access.AccessFragment"
        android:label=""
        tools:layout="@layout/fragment_access" >
        <action
            android:id="@+id/action_accessFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_accessFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>